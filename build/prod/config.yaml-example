app_env: production
log_level: info

database:
  host: postgres
  port: "5432"
  name: shizoid
  user: shizoid
  password: changeme

telegram:
  token: "111111111:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
  webhook_url: "" # empty = long polling
  webhook_secret_token: ""

sentry:
  dsn: ""
  environment: production
  release: ""

app:
  allow_to_all: false
  bot_owners:
    - 11111111
  bind_to: 8095
  locale: ru
  generation_mode: neural
  winner_cron: "20 1 * * *"
  memory_cron: "0 */6 * * *"
  summary_queue_cron: "@every 1m"
  # prompts: named blocks the system prompts are assembled from. Each block
  # falls back to a built-in default when omitted. Assembly order is fixed in
  # code (internal/config/prompts.go):
  #   reply   = chat_role + chat_memory + chat_format + telegram_markup + chat_length + precedence
  #   winner  = winner_role + winner_data + winner_format + telegram_markup + winner_tone + precedence
  #   summary = summary_role + summary_rules + summary_format
  # prompts:
  #   telegram_markup: |
  #     [TELEGRAM MARKUP]
  #     - Only plain text, no markup at all.

neural:
  reply:
    - name: openrouter
      base_url: https://openrouter.ai/api/v1
      api_key: sk-or-v1-...
      model: "openrouter/free"
      context_size: 32000
      timeout_seconds: 60
      sampling:
        temperature: 0.7
        top_p: 0.8
        top_k: 20
        min_p: 0.0
        presence_penalty: 1.5
        repeat_penalty: 1.0
  summary:
    - name: openrouter
      base_url: https://openrouter.ai/api/v1
      api_key: sk-or-v1-...
      model: "openrouter/free"
      timeout_seconds: 120
    - name: local
      base_url: http://llama:3110/v1
      model: Qwen3-1.7B-Q4_K_M.gguf
      context_size: 8192
      timeout_seconds: 120
      slot_check: true
      sampling:
        temperature: 1.0
        top_p: 0.95
        top_k: 20
        min_p: 0.0
        presence_penalty: 1.5
        repeat_penalty: 1.0
