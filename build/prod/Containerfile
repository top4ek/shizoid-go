# syntax=docker/dockerfile:1.4
FROM golang:1.27-alpine AS builder

WORKDIR /opt

ENV GO111MODULE=on
ENV GOOS=linux
ENV GOARCH=amd64
ENV CGO_ENABLED=0

RUN apk --no-cache --update add ca-certificates git

ARG GIT_COMMIT=unknown

COPY go.work ./
COPY apps/shizoid/go.mod apps/shizoid/go.sum ./apps/shizoid/
WORKDIR /opt/apps/shizoid
RUN --mount=type=cache,target=/go/pkg/mod go mod download && go mod verify

WORKDIR /opt
COPY . .

WORKDIR /opt/apps/shizoid
RUN --mount=type=cache,target=/go/pkg/mod go build -trimpath \
  -ldflags="-s -w -X apps/shizoid/internal/version.commit=${GIT_COMMIT}" \
  -o /shizoid ./cmd/app

FROM scratch

EXPOSE 8095

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /shizoid /shizoid

CMD ["/shizoid"]
